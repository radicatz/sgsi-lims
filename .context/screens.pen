                },
                {
                  "type": "text",
                  "id": "Z0pbP",
                  "name": "Intro",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": 820,
                  "content": "Tokens, type, and components for the SGSI Laboratory Information Management System — from drill-hole registration and batch preparation to ROA input, review, and export. Navy carries structure, amber marks attention, rust flags what needs a recheck.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-primary",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
