# Copy this file to .env (never commit .env) and fill the two secrets from the Supabase dashboard.
# Project: sgsi-lims (waxtkvfepwdopggynwlv), region ap-northeast-1

# Public values (safe to share)
SUPABASE_URL=https://waxtkvfepwdopggynwlv.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_zzcdPVN5VF1TMh-yPWvH9g_iIfQkD_6

# SECRET 1: Project Settings > API Keys > Secret keys (starts with sb_secret_). Used by the API for invites,
# password resets and the sign-in lock. Never put it in the web app.
SUPABASE_SECRET_KEY=

# SECRET 2: Connect (top bar) > Connection string > "Transaction pooler" (port 6543), with your database password
# in place of [YOUR-PASSWORD]. The API connects with it and runs each request as the signed-in user.
DATABASE_URL=

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
LAB_TIMEZONE=Asia/Makassar
