{
  "name": "sgsi-lims",
  "private": true,
  "description": "SGSI Coal LIMS v1: web app, API and shared rules",
  "packageManager": "pnpm@10.34.9",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel --filter @sgsi/api --filter @sgsi/web dev",
    "dev:api": "pnpm --filter @sgsi/api dev",
    "dev:web": "pnpm --filter @sgsi/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "seed:demo": "pnpm --filter @sgsi/api seed:demo"
  }
}
